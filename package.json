{
  "name": "front-end",
  "version": "1.0.0",
  "description": "Frontend application with JSON Server",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "server": "json-server --watch db.json --port 3300",
    "serve-site": "npx http-server site -p 5500",
    "start": "concurrently \"npm:server\" \"npm:serve-site\"",
    "dev": "npm run start"
  },
